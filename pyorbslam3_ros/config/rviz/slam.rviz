Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Color: 160; 160; 164
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.3
      Show Names: true
      Show Arrows: false
      Show Axes: true
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Enabled: true
      Color: 25; 255; 0
      Line Style: Lines
      Line Width: 0.03
      Topic:
        Value: /orbslam3/path
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Pose
      Name: Pose
      Enabled: true
      Shape: Axes
      Axes Length: 0.3
      Axes Radius: 0.03
      Topic:
        Value: /orbslam3/pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Tracked points
      Enabled: true
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 85; 0
      Decay Time: 0
      Topic:
        Value: /orbslam3/tracked_points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.8
      Yaw: 0.8
      Target Frame: <Fixed Frame>
      Name: Current View
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
